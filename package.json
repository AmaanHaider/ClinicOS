{
  "name": "clinic-scheduling-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --exclude tests/zz-seed.test.js",
    "test:seed": "vitest run tests/zz-seed.test.js",
    "test:all": "npm test && npm run test:seed",
    "test:watch": "vitest",
    "seed": "node scripts/seed.js",
    "setup:indexes": "node scripts/setup-indexes.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.5.0",
    "mongoose": "^8.9.5",
    "nanoid": "^5.0.9",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "vitest": {
    "testTimeout": 120000,
    "hookTimeout": 120000,
    "fileParallelism": false,
    "maxWorkers": 1
  }
}
