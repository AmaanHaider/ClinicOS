{
  "info": {
    "_postman_id": "clinicos-collection",
    "name": "ClinicOS",
    "description": "All ClinicOS API calls in plain English.\n\n**Start here:** folder \"1 — Setup and login\" (run top to bottom once).\n\n**Book a visit:** \"4 — Find open slots\" then \"5 — Book and manage appointments\".\n\n**Double-booking test:** folder \"7 — Two patients, same slot\".\n\nSetup: docker compose up -d → npm run setup:indexes → npm run seed → npm run dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "clinicId", "value": "clinic_india" },
    { "key": "patientEmail", "value": "patient@demo.local" },
    { "key": "staffEmail", "value": "staff@demo.local" },
    { "key": "password", "value": "password123" },
    { "key": "patientToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "appointmentTypeId", "value": "" },
    { "key": "slotStart", "value": "" },
    { "key": "newSlotStart", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "waitlistId", "value": "" },
    { "key": "slotsFrom", "value": "" },
    { "key": "slotsTo", "value": "" },
    { "key": "exceptionDate", "value": "2099-06-20" }
  ],
  "item": [
    {
      "name": "1 — Setup and login",
      "item": [
        {
          "name": "Check server is running",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Create a new clinic",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Clinic\",\n  \"timezone\": \"Asia/Kolkata\",\n  \"contactEmail\": \"postman-clinic@example.com\"\n}"
            },
            "url": "{{baseUrl}}/clinics"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 && pm.response.json()._id) {",
                "  pm.collectionVariables.set('newClinicId', pm.response.json()._id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Sign up as patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Demo Patient\",\n  \"role\": \"patient\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set('patientToken', pm.response.json().accessToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Sign up as staff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Demo Staff\",\n  \"role\": \"clinic_staff\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set('staffToken', pm.response.json().accessToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Log in as patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login OK', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('patientToken', pm.response.json().accessToken);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Log in as staff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login OK', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('staffToken', pm.response.json().accessToken);"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "2 — Doctors and visit types",
      "item": [
        {
          "name": "List all doctors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/clinics/{{clinicId}}/doctors"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const data = pm.response.json().data || [];",
                "const dr = data.find(d => (d.name || '').includes('Sharma')) || data[0];",
                "if (dr) pm.collectionVariables.set('doctorId', dr._id);",
                "pm.test('doctorId set', () => pm.expect(pm.collectionVariables.get('doctorId')).to.not.be.empty);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Add a new doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr Postman\",\n  \"specialisation\": \"GP\",\n  \"email\": \"dr.postman@example.com\",\n  \"supportedAppointmentTypes\": [\"{{appointmentTypeId}}\"]\n}"
            },
            "url": "{{baseUrl}}/clinics/{{clinicId}}/doctors"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 && pm.response.json()._id) {",
                "  pm.collectionVariables.set('newDoctorId', pm.response.json()._id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "List visit types",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/clinics/{{clinicId}}/appointment-types"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const data = pm.response.json().data || [];",
                "const t = data.find(x => x.name === 'General Consult') || data[0];",
                "if (t) pm.collectionVariables.set('appointmentTypeId', t._id);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Add a visit type",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Follow-up\",\n  \"durationMinutes\": 20,\n  \"color\": \"#336699\"\n}"
            },
            "url": "{{baseUrl}}/clinics/{{clinicId}}/appointment-types"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 && pm.response.json()._id) {",
                "  pm.collectionVariables.set('newAppointmentTypeId', pm.response.json()._id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Update a visit type",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color\": \"#ff9900\",\n  \"durationMinutes\": 25\n}"
            },
            "url": "{{baseUrl}}/appointment-types/{{appointmentTypeId}}"
          }
        }
      ]
    },
    {
      "name": "3 — Doctor schedule and time off",
      "item": [
        {
          "name": "View doctor weekly hours",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability"
          }
        },
        {
          "name": "Set doctor weekly hours",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weeklyTemplate\": {\n    \"MON\": [{\"start\": \"09:00\", \"end\": \"12:00\"}, {\"start\": \"14:00\", \"end\": \"17:00\"}],\n    \"TUE\": [{\"start\": \"09:00\", \"end\": \"17:00\"}],\n    \"WED\": [{\"start\": \"09:00\", \"end\": \"13:00\"}],\n    \"THU\": [{\"start\": \"10:00\", \"end\": \"17:00\"}],\n    \"FRI\": [{\"start\": \"09:00\", \"end\": \"13:00\"}],\n    \"SAT\": [],\n    \"SUN\": []\n  }\n}"
            },
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability"
          }
        },
        {
          "name": "Block a day off",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{exceptionDate}}\",\n  \"type\": \"block\",\n  \"reason\": \"Postman block day\"\n}"
            },
            "url": "{{baseUrl}}/doctors/{{doctorId}}/exceptions"
          }
        },
        {
          "name": "Change hours for one day",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2099-07-01\",\n  \"type\": \"override\",\n  \"windows\": [{\"start\": \"10:00\", \"end\": \"14:00\"}],\n  \"reason\": \"Postman override day\"\n}"
            },
            "url": "{{baseUrl}}/doctors/{{doctorId}}/exceptions"
          }
        },
        {
          "name": "Remove a day exception",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/exceptions/{{exceptionDate}}"
          }
        },
        {
          "name": "Preview schedule changes (dry run)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposedTemplate\": {\n    \"MON\": [{\"start\": \"09:00\", \"end\": \"12:00\"}],\n    \"TUE\": [{\"start\": \"10:00\", \"end\": \"17:00\"}],\n    \"WED\": [{\"start\": \"09:00\", \"end\": \"13:00\"}],\n    \"THU\": [{\"start\": \"10:00\", \"end\": \"17:00\"}],\n    \"FRI\": [{\"start\": \"09:00\", \"end\": \"13:00\"}],\n    \"SAT\": [],\n    \"SUN\": []\n  },\n  \"dateRange\": { \"from\": \"{{slotsFrom}}\", \"to\": \"{{slotsTo}}\" }\n}"
            },
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability/validate"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": [
                "if (!pm.collectionVariables.get('slotsFrom')) {",
                "  const from = new Date(); from.setDate(from.getDate() + 5);",
                "  const to = new Date(); to.setDate(to.getDate() + 12);",
                "  pm.collectionVariables.set('slotsFrom', from.toISOString().slice(0, 10));",
                "  pm.collectionVariables.set('slotsTo', to.toISOString().slice(0, 10));",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "4 — Find open slots",
      "item": [
        {
          "name": "Get available time slots",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const from = new Date(); from.setDate(from.getDate() + 5);",
                  "const to = new Date(); to.setDate(to.getDate() + 12);",
                  "pm.collectionVariables.set('slotsFrom', from.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('slotsTo', to.toISOString().slice(0, 10));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const slots = pm.response.json().slots || [];",
                  "pm.test('Has slots', () => pm.expect(slots.length).to.be.above(0));",
                  "if (slots[0]) pm.collectionVariables.set('slotStart', slots[0].start);",
                  "if (slots[1]) pm.collectionVariables.set('newSlotStart', slots[1].start);",
                  "else if (slots[0]) pm.collectionVariables.set('newSlotStart', slots[0].start);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/slots?clinicId={{clinicId}}&doctorId={{doctorId}}&appointmentType={{appointmentTypeId}}&from={{slotsFrom}}&to={{slotsTo}}",
              "host": ["{{baseUrl}}"],
              "path": ["slots"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}" },
                { "key": "appointmentType", "value": "{{appointmentTypeId}}" },
                { "key": "from", "value": "{{slotsFrom}}" },
                { "key": "to", "value": "{{slotsTo}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5 — Book and manage appointments",
      "description": "Run \"Get available time slots\" first. Reschedule needs a different time than the one you booked.",
      "item": [
        {
          "name": "Book appointment (5 min hold)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"appointmentTypeId\": \"{{appointmentTypeId}}\",\n  \"slotStart\": \"{{slotStart}}\",\n  \"patientId\": \"demo_patient_1\",\n  \"idempotencyKey\": \"postman-{{$timestamp}}\",\n  \"patient\": { \"name\": \"Demo Patient\" }\n}"
            },
            "url": "{{baseUrl}}/appointments"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Created', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('appointmentId', pm.response.json()._id);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "View appointment details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "Confirm appointment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/confirm"
          }
        },
        {
          "name": "Reschedule to another time",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newSlotStart\": \"{{newSlotStart}}\",\n  \"reason\": \"Postman reschedule\"\n}"
            },
            "url": "{{baseUrl}}/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "View appointment history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/history"
          }
        },
        {
          "name": "List appointments for a patient (staff)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/clinics/{{clinicId}}/appointments?patientId=demo_patient_1",
              "host": ["{{baseUrl}}"],
              "path": ["clinics", "{{clinicId}}", "appointments"],
              "query": [{ "key": "patientId", "value": "demo_patient_1" }]
            }
          }
        },
        {
          "name": "Mark as no-show (staff)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/noshow"
          },
          "description": "Only works for past appointments. Future visits may return an error."
        },
        {
          "name": "Mark as completed (staff)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/complete"
          },
          "description": "Only works for past appointments. Future visits may return an error."
        },
        {
          "name": "Cancel appointment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelledBy\": \"patient\",\n  \"reason\": \"Postman demo cancel\"\n}"
            },
            "url": "{{baseUrl}}/appointments/{{appointmentId}}"
          }
        }
      ]
    },
    {
      "name": "6 — Waitlist",
      "description": "Join waitlist only when that day has no open slots. Run \"Block a day off\" first, or pick a fully booked day.",
      "item": [
        {
          "name": "Join waitlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"appointmentTypeId\": \"{{appointmentTypeId}}\",\n  \"targetDate\": \"{{exceptionDate}}\",\n  \"patientId\": \"waitlist_demo_patient\",\n  \"urgencyFlag\": false,\n  \"patient\": { \"name\": \"Waitlist Demo\" }\n}"
            },
            "url": "{{baseUrl}}/waitlist"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set('waitlistId', pm.response.json()._id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "View doctor waitlist (staff)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/waitlist"
          }
        },
        {
          "name": "Accept waitlist offer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/waitlist/{{waitlistId}}/accept"
          },
          "description": "Works after a slot opens and you get an offer (e.g. someone cancels)."
        },
        {
          "name": "Leave waitlist",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/waitlist/{{waitlistId}}"
          }
        }
      ]
    },
    {
      "name": "7 — Two patients, same slot",
      "description": "Send both requests at the same time. One should succeed (201), the other should fail (409 slot taken). Or run: npm test -- tests/booking.concurrency.test.js",
      "item": [
        {
          "name": "Book slot — patient A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"appointmentTypeId\": \"{{appointmentTypeId}}\",\n  \"slotStart\": \"{{slotStart}}\",\n  \"patientId\": \"race_patient_a\",\n  \"idempotencyKey\": \"race-a-{{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "Book slot — patient B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"appointmentTypeId\": \"{{appointmentTypeId}}\",\n  \"slotStart\": \"{{slotStart}}\",\n  \"patientId\": \"race_patient_b\",\n  \"idempotencyKey\": \"race-b-{{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/appointments"
          }
        }
      ]
    }
  ]
}
