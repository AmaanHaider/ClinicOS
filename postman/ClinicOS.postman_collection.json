{
  "info": {
    "_postman_id": "clinicos-auth-manual",
    "name": "ClinicOS API (Auth Flow)",
    "description": "Auth-first manual collection.\n\n**Only collection variable:** `accessToken` (Bearer JWT).\n\n## Flow\n1. Run public requests (Health, Create Clinic, Signup/Login).\n2. Copy `accessToken` from signup/login response into collection variable `accessToken`.\n3. Copy IDs from each response into the next request URL/body by hand.\n\nNo other variables. No auto-scripts.\n\n```bash\nnpm run setup:indexes && npm run dev\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "accessToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "http://localhost:3000/health"
          }
        }
      ]
    },
    {
      "name": "01 Setup & Auth",
      "item": [
        {
          "name": "POST Create Clinic",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Clinic\",\n  \"timezone\": \"Asia/Kolkata\",\n  \"contactEmail\": \"admin@postman.test\",\n  \"address\": {\n    \"line1\": \"1 Test Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  }\n}"
            },
            "url": "http://localhost:3000/clinics",
            "description": "Copy `_id` from response → use as clinicId in auth + URLs below."
          }
        },
        {
          "name": "POST Auth Signup (staff)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"PASTE_CLINIC_ID_HERE\",\n  \"email\": \"staff@postman.test\",\n  \"password\": \"StrongPass123!\",\n  \"name\": \"Staff User\",\n  \"role\": \"clinic_staff\"\n}"
            },
            "url": "http://localhost:3000/auth/signup",
            "description": "Copy `accessToken` from response → set collection variable `accessToken`."
          }
        },
        {
          "name": "POST Auth Login (staff)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"PASTE_CLINIC_ID_HERE\",\n  \"email\": \"staff@postman.test\",\n  \"password\": \"StrongPass123!\"\n}"
            },
            "url": "http://localhost:3000/auth/login",
            "description": "Copy `accessToken` → set collection variable `accessToken`."
          }
        },
        {
          "name": "POST Auth Signup (patient)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"PASTE_CLINIC_ID_HERE\",\n  \"email\": \"patient@postman.test\",\n  \"password\": \"StrongPass123!\",\n  \"name\": \"Test Patient\",\n  \"role\": \"patient\"\n}"
            },
            "url": "http://localhost:3000/auth/signup",
            "description": "For patient-only actions (book/waitlist), paste patient `accessToken` into collection variable `accessToken`."
          }
        }
      ]
    },
    {
      "name": "02 Appointment Types",
      "item": [
        {
          "name": "POST Create Appointment Type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"General Consult\",\n  \"durationMinutes\": 15,\n  \"color\": \"#4A90E2\"\n}"
            },
            "url": "http://localhost:3000/clinics/PASTE_CLINIC_ID_HERE/appointment-types"
          }
        },
        {
          "name": "GET List Appointment Types",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/clinics/PASTE_CLINIC_ID_HERE/appointment-types"
          }
        },
        {
          "name": "PATCH Update Appointment Type",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationMinutes\": 20\n}"
            },
            "url": "http://localhost:3000/appointment-types/PASTE_APPOINTMENT_TYPE_ID_HERE"
          }
        }
      ]
    },
    {
      "name": "03 Doctors",
      "item": [
        {
          "name": "POST Create Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Postman Test\",\n  \"specialisation\": \"General Physician\",\n  \"email\": \"doctor@postman.test\",\n  \"supportedAppointmentTypes\": [\"PASTE_APPOINTMENT_TYPE_ID_HERE\"]\n}"
            },
            "url": "http://localhost:3000/clinics/PASTE_CLINIC_ID_HERE/doctors"
          }
        },
        {
          "name": "GET List Doctors",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/clinics/PASTE_CLINIC_ID_HERE/doctors"
          }
        }
      ]
    },
    {
      "name": "04 Availability",
      "item": [
        {
          "name": "PUT Set Weekly Availability",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weeklyTemplate\": {\n    \"MON\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"TUE\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"WED\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"THU\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"FRI\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"SAT\": [],\n    \"SUN\": []\n  }\n}"
            },
            "url": "http://localhost:3000/doctors/PASTE_DOCTOR_ID_HERE/availability"
          }
        },
        {
          "name": "GET Get Availability",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/doctors/PASTE_DOCTOR_ID_HERE/availability"
          }
        },
        {
          "name": "POST Add Exception (block)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"YYYY-MM-DD\",\n  \"type\": \"block\",\n  \"reason\": \"Conference\"\n}"
            },
            "url": "http://localhost:3000/doctors/PASTE_DOCTOR_ID_HERE/exceptions"
          }
        },
        {
          "name": "POST Validate Availability",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposedTemplate\": {\n    \"MON\": [{ \"start\": \"09:00\", \"end\": \"12:00\" }],\n    \"TUE\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"WED\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"THU\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"FRI\": [{ \"start\": \"09:00\", \"end\": \"17:00\" }],\n    \"SAT\": [],\n    \"SUN\": []\n  },\n  \"dateRange\": {\n    \"from\": \"YYYY-MM-DD\",\n    \"to\": \"YYYY-MM-DD\"\n  }\n}"
            },
            "url": "http://localhost:3000/doctors/PASTE_DOCTOR_ID_HERE/availability/validate"
          }
        }
      ]
    },
    {
      "name": "05 Slots",
      "item": [
        {
          "name": "GET Available Slots",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/slots?clinicId=PASTE_CLINIC_ID_HERE&doctorId=PASTE_DOCTOR_ID_HERE&appointmentType=PASTE_APPOINTMENT_TYPE_ID_HERE&from=YYYY-MM-DD&to=YYYY-MM-DD",
            "description": "Max 30-day range. Copy a slot `start` for booking."
          }
        }
      ]
    },
    {
      "name": "06 Appointments",
      "item": [
        {
          "name": "POST Book Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"PASTE_DOCTOR_ID_HERE\",\n  \"appointmentTypeId\": \"PASTE_APPOINTMENT_TYPE_ID_HERE\",\n  \"slotStart\": \"PASTE_SLOT_START_ISO_HERE\",\n  \"patientId\": \"patient_postman\",\n  \"patient\": {\n    \"name\": \"Test Patient\",\n    \"phone\": \"+91-9876543210\",\n    \"email\": \"patient@postman.test\"\n  },\n  \"notes\": \"Postman booking test\"\n}"
            },
            "url": "http://localhost:3000/appointments",
            "description": "Use patient token in `accessToken` if booking as patient."
          }
        },
        {
          "name": "PATCH Confirm Appointment",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:3000/appointments/PASTE_APPOINTMENT_ID_HERE/confirm"
          }
        },
        {
          "name": "GET Get Appointment",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/appointments/PASTE_APPOINTMENT_ID_HERE"
          }
        },
        {
          "name": "GET Appointment History",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/appointments/PASTE_APPOINTMENT_ID_HERE/history"
          }
        },
        {
          "name": "GET List Appointments",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/clinics/PASTE_CLINIC_ID_HERE/appointments?doctorId=PASTE_DOCTOR_ID_HERE&from=YYYY-MM-DD&to=YYYY-MM-DD&limit=20"
          }
        },
        {
          "name": "PATCH Reschedule Appointment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newSlotStart\": \"PASTE_NEW_SLOT_START_ISO_HERE\",\n  \"reason\": \"Postman reschedule test\"\n}"
            },
            "url": "http://localhost:3000/appointments/PASTE_APPOINTMENT_ID_HERE"
          }
        },
        {
          "name": "DELETE Cancel Appointment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelledBy\": \"patient\",\n  \"reason\": \"Postman cancel test\"\n}"
            },
            "url": "http://localhost:3000/appointments/PASTE_APPOINTMENT_ID_HERE"
          }
        },
        {
          "name": "PATCH Mark No-Show",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:3000/appointments/PASTE_APPOINTMENT_ID_HERE/noshow",
            "description": "Staff token in `accessToken`. Appointment must be confirmed and in the past."
          }
        },
        {
          "name": "PATCH Mark Complete",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:3000/appointments/PASTE_APPOINTMENT_ID_HERE/complete"
          }
        }
      ]
    },
    {
      "name": "07 Waitlist",
      "item": [
        {
          "name": "POST Join Waitlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"PASTE_DOCTOR_ID_HERE\",\n  \"appointmentTypeId\": \"PASTE_APPOINTMENT_TYPE_ID_HERE\",\n  \"targetDate\": \"YYYY-MM-DD\",\n  \"patient\": { \"name\": \"Waitlist Patient\", \"phone\": \"+91-9999999999\" },\n  \"urgencyFlag\": false\n}"
            },
            "url": "http://localhost:3000/waitlist",
            "description": "Day must have zero slots. Use patient token in `accessToken`. Omit patientId to use JWT user id."
          }
        },
        {
          "name": "GET List Waitlist",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/doctors/PASTE_DOCTOR_ID_HERE/waitlist?targetDate=YYYY-MM-DD&appointmentTypeId=PASTE_APPOINTMENT_TYPE_ID_HERE"
          }
        },
        {
          "name": "POST Accept Waitlist Offer",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/waitlist/PASTE_WAITLIST_ID_HERE/accept",
            "description": "Patient token must own the waitlist entry."
          }
        },
        {
          "name": "DELETE Remove Waitlist Entry",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/waitlist/PASTE_WAITLIST_ID_HERE"
          }
        }
      ]
    },
    {
      "name": "08 Auth Errors",
      "item": [
        {
          "name": "POST Login Wrong Password (expect 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"PASTE_CLINIC_ID_HERE\",\n  \"email\": \"staff@postman.test\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "url": "http://localhost:3000/auth/login"
          }
        },
        {
          "name": "GET Doctors Clinic Mismatch (expect 403)",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/clinics/clinic_wrong_id/doctors"
          }
        }
      ]
    }
  ]
}
