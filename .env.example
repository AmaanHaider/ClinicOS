PORT=3000
# MongoDB Atlas (replace user, password, and cluster host from Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/clinic_scheduling?retryWrites=true&w=majority&appName=Cluster0
# Local Docker replica set (optional)
# MONGODB_URI=mongodb://localhost:27017/clinic_scheduling?replicaSet=rs0
JWT_SECRET=dev-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
MAX_SLOT_QUERY_DAYS=30
PENDING_HOLD_MINUTES=5
WAITLIST_OFFER_MINUTES=15
